{
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/soft_inject.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*subsystem_add|.*subsystem_choose_part",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/hard_enforce.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/block_canonical_writes.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/post_subagent.py"
          }
        ]
      },
      {
        "matcher": ".*subsystem_choose_part",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hw_agent/.claude/hooks/post_bom_accumulate.py"
          }
        ]
      }
    ]
  }
}
