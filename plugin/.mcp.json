{
  "mcpServers": {
    "designer": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/ORG/hw-toolkit@v0.1.0", "designer-mcp"],
      "env": {
        "KICAD_CLI": "${KICAD_CLI}",
        "ELK_NODE_PATH": "${CLAUDE_PLUGIN_DATA}/node_modules"
      }
    },
    "router": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/ORG/hw-toolkit@v0.1.0", "router-mcp"]
    },
    "live-edit": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/ORG/hw-toolkit@v0.1.0", "live-edit-mcp"],
      "env": { "KICAD_CLI": "${KICAD_CLI}" }
    }
  }
}
